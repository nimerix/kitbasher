{
  "name": "kitbasher",
  "version": "1.0.0",
  "description": "A local-first 3D assembly workbench for multipart models",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:mcp",
    "build:mcp": "vite build --config vite.mcp.config.ts && vite build --config vite.mcp.config.ts --mode headset",
    "preview": "vite preview --host 0.0.0.0",
    "headset": "npm run build && node dist-mcp/kitbasher-headset.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src mcp tests *.ts *.json index.html docs/*.md README.md",
    "format:check": "prettier --check src mcp tests *.ts *.json index.html docs/*.md README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimerix/kitbasher.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nimerix/kitbasher/issues"
  },
  "homepage": "https://github.com/nimerix/kitbasher#readme",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.70.0",
    "ml-matrix": "^6.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.18",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "iwer": "^2.8.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
