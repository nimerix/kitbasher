{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitbasher",
  "main": "worker/drive-auth.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/drive/*"],
  },
}
